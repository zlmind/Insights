# Insights Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Required
# ===================

# OpenAI API key for summarization, action item extraction, and thumbnail generation (DALL-E 3)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: send the OpenAI-style calls to an OpenAI-compatible endpoint instead
# of api.openai.com (any gateway that serves /chat/completions, e.g. a GLM proxy,
# or DeepSeek with OPENAI_MODEL=deepseek-v4-flash — its yuan prices are already
# in the usage tables). Only chat goes through this endpoint: Whisper
# transcription and thumbnail images always call api.openai.com directly.
# OPENAI_BASE_URL=https://llm.goaichat.top/v1
# OPENAI_BASE_URL=https://api.deepseek.com

# Thumbnails: uses OpenAI Images API (gpt-image-1) with OPENAI_API_KEY by default.
# Optional: set only if you use a custom CLI that accepts the JSON payload on argv (legacy).
# ASI_GENERATE_IMAGE=/full/path/to/your-thumbnail-cli

# ===================
# Optional
# ===================

# Model to use (default: glm-5.3). Any model the configured endpoint serves.
# GPT-5-and-later reasoning models get their older max_tokens/temperature
# settings adapted automatically.
# OPENAI_MODEL=glm-5.3
# How hard OpenAI reasoning models think before answering: low (default), medium,
# high, xhigh, max. Higher is slower and costs more; routine copy rarely needs it.
# OPENAI_REASONING_EFFORT=low

# Cloud LLM provider for text/vision generation: "openai" (default) or "anthropic".
# Whisper transcription and thumbnail image generation always use OpenAI (Anthropic
# has no equivalent), so keep OPENAI_API_KEY set for those even when using Anthropic.
# LLM_PROVIDER=openai

# Anthropic (Claude) API key. Required only when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude model to use when LLM_PROVIDER=anthropic (default: claude-opus-5-5).
# Others: claude-sonnet-5-5 (cheaper), claude-fable-5-1 (most capable, costs most),
# claude-haiku-4-5 (fastest).
# ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth for Opus 5.x / Sonnet 5.x / Fable: low (default), medium, high,
# xhigh, max.
# ANTHROPIC_EFFORT=low
# When a safety classifier declines a request, re-run it on a fallback model in
# the same call (on by default). Set to 0 to disable.
# ANTHROPIC_REFUSAL_FALLBACK=1

# Ollama for local AI (optional, for free post generation)
# Install from https://ollama.com then run: ollama pull llama3.2-vision && ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=llama3.2-vision
# OLLAMA_TEXT_MODEL=llama3.2

# Usage meters (/usage page): estimated cost per AI call. Token counts are exact;
# cost is estimated from the rates below. All prices are in YUAN (元) per
# 1,000,000 tokens (input / output); Whisper is yuan per minute; image is yuan
# per image. The GPT/Claude defaults are their USD list prices converted at 7.2
# (2026-10) — override any to match your plan. DeepSeek's are DeepSeek's own
# official yuan prices, so they need no override.
# USAGE_PRICE_DEEPSEEK_V4_PRO_IN=3.00
# USAGE_PRICE_DEEPSEEK_V4_PRO_OUT=6.00
# USAGE_PRICE_DEEPSEEK_V4_FLASH_IN=1.00
# USAGE_PRICE_DEEPSEEK_V4_FLASH_OUT=2.00
# USAGE_PRICE_GPT_6_ASTRA_IN=72.00
# USAGE_PRICE_GPT_6_ASTRA_OUT=360.00
# USAGE_PRICE_GPT_6_SOL_IN=14.40
# USAGE_PRICE_GPT_6_SOL_OUT=72.00
# USAGE_PRICE_GPT_6_LUNA_IN=0.72
# USAGE_PRICE_GPT_6_LUNA_OUT=3.60
# USAGE_PRICE_GPT_4O_IN=18.00
# USAGE_PRICE_GPT_4O_OUT=72.00
# USAGE_PRICE_GPT_4O_MINI_IN=1.08
# USAGE_PRICE_GPT_4O_MINI_OUT=4.32
# USAGE_PRICE_GPT_41_IN=14.40
# USAGE_PRICE_GPT_41_OUT=57.60
# USAGE_PRICE_GPT_41_MINI_IN=2.88
# USAGE_PRICE_GPT_41_MINI_OUT=11.52
# USAGE_PRICE_DEFAULT_IN=18.00
# USAGE_PRICE_DEFAULT_OUT=72.00
# USAGE_WHISPER_PER_MIN=0.0432
# USAGE_PRICE_IMAGE=1.368
# Anthropic (Claude) chat rates, yuan per 1,000,000 tokens (input / output),
# matched by model-name prefix. Used when LLM_PROVIDER=anthropic.
# USAGE_PRICE_CLAUDE_FABLE_IN=72.00
# USAGE_PRICE_CLAUDE_FABLE_OUT=360.00
# USAGE_PRICE_CLAUDE_OPUS_5_5_IN=28.80
# USAGE_PRICE_CLAUDE_OPUS_5_5_OUT=144.00
# USAGE_PRICE_CLAUDE_SONNET_5_IN=14.40
# USAGE_PRICE_CLAUDE_SONNET_5_OUT=72.00
# USAGE_PRICE_CLAUDE_OPUS_IN=36.00
# USAGE_PRICE_CLAUDE_OPUS_OUT=180.00
# USAGE_PRICE_CLAUDE_SONNET_IN=21.60
# USAGE_PRICE_CLAUDE_SONNET_OUT=108.00
# USAGE_PRICE_CLAUDE_HAIKU_IN=7.20
# USAGE_PRICE_CLAUDE_HAIKU_OUT=36.00
# USAGE_PRICE_CLAUDE_DEFAULT_IN=36.00
# USAGE_PRICE_CLAUDE_DEFAULT_OUT=180.00
# Generic per-model pricing for ANY model not in the tables above, no code
# change needed. The model name is normalized (lowercase, non-alphanumeric ->
# _) and matched by longest prefix, and these yuan rates win over the built-in
# tables. Example for a hypothetical new domestic model (prices from its
# provider's price page, yuan per 1M tokens):
# USAGE_PRICE_MODEL_QWEN_MAX_IN=2.40
# USAGE_PRICE_MODEL_QWEN_MAX_OUT=9.60

# Port for the Flask web server (default: 5001)
# PORT=5001

# ===================
# LinkedIn Integration (Optional)
# ===================
# Required to post to LinkedIn. Create an app at https://www.linkedin.com/developers/apps
# Enable "Share on LinkedIn" product and (optionally) "Sign In with LinkedIn using OpenID Connect"

# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# LINKEDIN_REDIRECT_URI=http://localhost:5001/linkedin/callback

# ===================
# Threads Integration (Optional)
# ===================
# Required to post to Threads. Create a Meta app at https://developers.facebook.com/apps/
# Add the "Threads API" product and configure a Threads tester (see Configure page for details)

# THREADS_APP_ID=your_threads_app_id
# THREADS_APP_SECRET=your_threads_app_secret
# THREADS_REDIRECT_URI=https://localhost:5001/threads/callback

# ===================
# Facebook Integration (Optional)
# ===================
# Required to post to Facebook Pages/Groups. Uses the same Meta Developer Portal as Threads.
# Create an app at https://developers.facebook.com/apps/ and add "Facebook Login for Business"
# Required permissions: pages_manage_posts, pages_read_engagement
# Optional: publish_to_groups (requires App Review for production; works in dev mode for admins)

# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
# FACEBOOK_REDIRECT_URI=http://localhost:5001/facebook/callback

# ===================
# X / Twitter Integration (Optional)
# ===================
# Required to post to X/Twitter. Create an app at https://developer.x.com
# Enable OAuth 2.0 with PKCE, set callback URL to your redirect URI.
# Pay-per-use: $0.01/post, includes media upload.

# TWITTER_CLIENT_ID=your_twitter_client_id
# TWITTER_CLIENT_SECRET=your_twitter_client_secret
# TWITTER_REDIRECT_URI=http://localhost:5001/twitter/callback

# ===================
# Instagram Integration (Optional)
# ===================
# Uses the "Instagram API with Instagram Login" (no Facebook Page required).
# Requires an Instagram professional (Business or Creator) account.
# Create a Meta app at https://developers.facebook.com/apps/, add the "Instagram"
# product, choose "API setup with Instagram login", and add your account as an
# Instagram Tester. Use the Instagram App ID/Secret shown under the Instagram
# product (NOT the Meta app's own ID/secret). Redirect URI must be HTTPS.
# Note: Instagram feed posts REQUIRE an image (JPEG on a public URL, aspect
# ratio 4:5 to 1.91:1) - configure Cloudinary and/or a stock image provider.

# INSTAGRAM_APP_ID=your_instagram_app_id
# INSTAGRAM_APP_SECRET=your_instagram_app_secret
# INSTAGRAM_REDIRECT_URI=https://localhost:5001/instagram/callback

# ===================
# Cloudinary (Optional)
# ===================
# Required for image uploads that work with Threads and other external platforms
# Sign up free at https://cloudinary.com

# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ===================
# Stock Images (Optional - all free)
# ===================
# Configure at least one to enable auto-image generation for posts
# All services are 100% free with generous rate limits

# Unsplash - Best quality, 50 req/hour
# Sign up at https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Pexels - Great quality, 200 req/hour  
# Sign up at https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key

# Pixabay - Good quality, 5000 req/hour
# Sign up at https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your_pixabay_api_key

# ============================================================
# Content Agent (agentic content preparation)
# ============================================================
# Master switch for the recurring-brief background worker.
# On-demand "Run now" still works even if this is false.
# CONTENT_AGENT_ENABLED=true
# How often (seconds) the worker checks for due briefs.
# CONTENT_AGENT_TICK_SECONDS=60
# Optional cheaper model for the agent's research LLM calls (query planning /
# brief synthesis). Defaults to OPENAI_MODEL when unset.
# CONTENT_AGENT_MODEL=gpt-6-luna
# Language for generation that happens outside a web request (scheduled
# briefs, feed workers): "en" (default) or "zh". Inside the web UI, summaries
# and articles follow the interface language, and posts follow each
# platform's language (domestic platforms like 小红书 generate in Chinese).
# CONTENT_LANG=en

# ---- Web search provider (research procurement) ----
# auto = Tavily if TAVILY_API_KEY set, else Brave if BRAVE_SEARCH_API_KEY set,
#        else OpenAI native web search (uses OPENAI_API_KEY), else none.
# WEB_SEARCH_PROVIDER=auto
# Tavily (recommended: clean, agent-friendly results). https://tavily.com
# TAVILY_API_KEY=
# Brave Search API (optional alternative). https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# Optional: override the OpenAI model used for native web search.
# OPENAI_SEARCH_MODEL=gpt-6.1-sol
# Results requested per search query.
# WEB_SEARCH_MAX_RESULTS=5

# ---- Research pipeline caps (bound cost + latency for unattended runs) ----
# RESEARCH_MAX_SEARCHES=6
# RESEARCH_MAX_FETCHES=15
# RESEARCH_MAX_ITEMS=12
# RESEARCH_QUERY_COUNT=4
# RESEARCH_PER_DOMAIN_CAP=2
# RESEARCH_MAX_TEXT_CHARS=8000
# Reuse cached url_sources content newer than this without re-fetching.
# RESEARCH_SOURCE_TTL_DAYS=14

# ---- External web-search cost estimates (USD per call), shown on /usage ----
# USAGE_PRICE_SEARCH_TAVILY=0.008
# USAGE_PRICE_SEARCH_BRAVE=0.005
